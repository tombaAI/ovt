# Povinné pro první deploy bez e-mailu.
# Na Vercelu použij jako DATABASE_URL connection string z Supabase Dashboard -> Connect.
# Pro serverless provoz je praktičtější transaction pooler connection string než přímé DB spojení.
DATABASE_URL=
ADMIN_EMAILS=admin@ovtbohemians.cz
# Volitelné. Pro první deploy na vercel.app URL ho zatím nepotřebuješ.
APP_BASE_URL=http://localhost:3000

# Volitelné až později pro e-mailing a cron.
# Pokud nastavíš jen RESEND_API_KEY, aplikace použije testovací sender onboarding@resend.dev.
# RESEND_API_KEY=
# MAIL_FROM=sprava@mail.ovtbohemians.cz
# MAIL_REPLY_TO=sprava@ovtbohemians.cz
# MAIL_TEST_TO=tvuj-email@example.com

# Bearer token pro cron endpointy (sync-bank) a admin endpointy (backfill-analyzed-amount).
# POZOR — isWebhookAuthorized() je fail-open: pokud proměnná není nastavená, endpoint
# projde BEZ AUTENTIZACE. Nastav i na produkci (Vercel), ne jen lokálně.
# CRON_SECRET=change-me

# Bearer token pro webhook importu členů TJ Bohemians (repository_dispatch z GHA
# workflow import-members-tj.yml). Stejné pravidlo fail-open jako u CRON_SECRET výše.
# IMPORT_SECRET_TJ=change-me

# Prostředí: 'staging' zobrazí modrou hlavičku a staging banner v UI. Výchozí: prázdné (produkce).
# NEXT_PUBLIC_APP_ENV=staging

# Číslo oddílu pro finance TJ (výsledky hospodaření, rekonciliace). Výchozí: 207.
# TJ_ODDIL_ID=207

# Hospodáři provozních výdajů — dvě oddělené role PER ODDÍL (OVT, TOM):
#   EMAIL_HOSPODAR_ODDILU_TJB / EMAIL_HOSPODAR_ODDILU_TOM = příjemce vyúčtovacího e-mailu na TJ
#   TREASURER_EMAIL / TREASURER_EMAIL_TOM                  = uživatel se schvalovacím právem v admin rozhraní
# EMAIL_HOSPODAR_ODDILU_TJB=hospodar-tj@example.com
# TREASURER_EMAIL=hospodar@ovtbohemians.cz
# EMAIL_HOSPODAR_ODDILU_TOM=hospodar-tom@example.com
# TREASURER_EMAIL_TOM=hospodarka-tom@example.com

# Volitelné až později, pokud začneš používat Supabase Auth nebo klientský Supabase SDK.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
